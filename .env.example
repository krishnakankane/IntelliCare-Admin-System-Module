# =============================================
# IntelliCare — Production Environment Template
# Copy to .env.prod and fill all values.
# NEVER commit .env.prod to version control.
# =============================================

# --- Server ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# --- Database ---
DB_HOST=postgres
DB_PORT=5432
DB_NAME=intellicaredb
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- JWT ---
# Must be >= 64 characters. Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_GENERATE_A_STRONG_SECRET_AT_LEAST_64_CHARS_LONG_HERE_!!
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# --- Mail ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=noreply@your-domain.com
MAIL_PASSWORD=CHANGE_ME_APP_PASSWORD
MAIL_FROM=noreply@your-domain.com

# --- AI ---
OPENAI_API_KEY=sk-CHANGE_ME
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2048
AI_MOCK_ENABLED=false

# --- Whisper ---
WHISPER_MODEL=whisper-1

# --- ElevenLabs ---
ELEVENLABS_API_KEY=CHANGE_ME
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --- Twilio ---
TWILIO_ACCOUNT_SID=CHANGE_ME
TWILIO_AUTH_TOKEN=CHANGE_ME
TWILIO_FROM_NUMBER=+1XXXXXXXXXX
TWILIO_MOCK_ENABLED=false

# --- WhatsApp ---
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_ACCESS_TOKEN=CHANGE_ME
WHATSAPP_PHONE_NUMBER_ID=CHANGE_ME
WHATSAPP_MOCK_ENABLED=false
